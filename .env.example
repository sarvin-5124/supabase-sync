# ── Google Sheets ──────────────────────────────────────────────────────────
# The long ID in your sheet URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=1vPVevrFvoV2RufElj0uLkKcXfJ2dbr_ZYyTCvSGrByY

# Full JSON content of your Google service account key file.
# In GitHub Actions, store as a secret and paste the entire JSON as one line.
# Local dev: paste the JSON inline or use: $(cat path/to/key.json)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"..."}

# ── Supabase — use service_role keys (not anon) ────────────────────────────
# service_role bypasses Row Level Security and guarantees table reads.
# Find them in: Supabase Dashboard → Project Settings → API → service_role key

# AFK Waitlist app  (table: waitlist)
SUPABASE_URL_AFK_WAITLIST=https://xxxx.supabase.co
SUPABASE_KEY_AFK_WAITLIST=eyJ...service_role_key...

# Beat Everyday  (table: leads)
SUPABASE_URL_BEAT_EVERYDAY=https://xxxx.supabase.co
SUPABASE_KEY_BEAT_EVERYDAY=eyJ...service_role_key...

# AFK Extension  (table: leads)
# URL is already known: https://ialyepwbyumawqiwlizd.supabase.co
SUPABASE_URL_AFK_EXTENSION=https://ialyepwbyumawqiwlizd.supabase.co
SUPABASE_KEY_AFK_EXTENSION=eyJ...service_role_key...

# Yogal backend  (table: "Signup" — PascalCase, Prisma-created)
SUPABASE_URL_YOGAL=https://xxxx.supabase.co
SUPABASE_KEY_YOGAL=eyJ...service_role_key...
